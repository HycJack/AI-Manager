<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="ai-manager"
        Arguments=""
        InstallLocation="C:\Program Files\HycJack\AI-Manager">
    </Installer>
    <PackageInformation
        PackageName="AI-Manager"
        PackageDisplayName="AI-Manager"
        PublisherName="CN=HycJack"
        PublisherDisplayName="HycJack"
        Version="0.1.0.0"
        PackageDescription="Cross-platform Agent Skills manager">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.hycjack.ai-manager"
                Description="Cross-platform Agent Skills manager"
                DisplayName="AI-Manager"
                ExecutableName="ai-manager"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>AI-Manager</DisplayName>
            <PublisherDisplayName>HycJack</PublisherDisplayName>
            <Description>Cross-platform Agent Skills manager</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="ai-manager.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
